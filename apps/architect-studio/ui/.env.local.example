# Sage PWA Environment Configuration

# MQTT WebSocket Broker URL
# This should point to your Mosquitto broker's WebSocket listener
# Default: ws://localhost:9001
# For network access: ws://YOUR_IP:9001
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001

# For production/remote access via Tailscale:
# NEXT_PUBLIC_MQTT_WS_URL=ws://100.x.x.x:9001
