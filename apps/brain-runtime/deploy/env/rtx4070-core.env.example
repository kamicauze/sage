# RTX 4070 Ti 12GB: brain + vision node

# Point to the Raspberry Pi 5 controller (MQTT broker).
MQTT_HOST=192.168.1.50
MQTT_PORT=1883

# Brain runtime settings.
OLLAMA_HOST=http://localhost:11434
DEFAULT_PERSONALITY=kenyan_babe
SAGE_STREAM_TTS=true

# Start vision service on this node.
START_VISION=1
VISION_LOCATION=office
VISION_CAMERA=0

# Vision profile tuned for continuous runtime on 12GB.
VISION_VLM_MODEL=moondream
VISION_VLM_INTERVAL=75
VISION_YOLO_MODEL=yolov8n
VISION_YOLO_INTERVAL=3

# Optional toggles.
VISION_NO_VLM=0
VISION_NO_YOLO=0
VISION_UI=0
