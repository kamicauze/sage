# Raspberry Pi 5: home node. Zigbee2MQTT + the Zigbee dongle live here.
# Zigbee2MQTT itself is configured in its own configuration.yaml:
#   mqtt:
#     server: mqtt://<mac-mini-ip>:1883

# The Mac Mini (hub) broker.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883

# Standalone testing only: 1 = this Pi also runs a broker and the switch controller.
SAGE_LOCAL_HUB=0

# Optional room sensor publisher (should publish to sage/sensors/<room>/presence).
# SAGE_SENSOR_CMD="python3 /home/pi/sensors/presence_publisher.py"
SAGE_SENSOR_CMD=
