# Raspberry Pi 5: sensor controller + MQTT broker

# MQTT broker port exposed to LAN devices.
MQTT_PORT=1883

# Set to 1 if mosquitto is managed externally (systemd/container).
SAGE_SKIP_BROKER=0

# Optional mosquitto config path.
# SAGE_MQTT_CONFIG=/etc/mosquitto/mosquitto.conf

# Optional sensor publisher command.
# It should publish to: sage/sensors/<room>/presence
# Example:
# SAGE_SENSOR_CMD="python3 /home/pi/sensors/presence_publisher.py"
SAGE_SENSOR_CMD=
