# Jetson Orin: vision node (camera + YOLO + faces + moondream VLM).

# The Mac Mini (hub) broker.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883

VISION_LOCATION=office
# Camera index (/dev/videoN). Check with: v4l2-ctl --list-devices
VISION_CAMERA=0

# VLM served by Ollama on the Orin itself (keeps video on this box).
VISION_OLLAMA_HOST=http://localhost:11434
VISION_VLM_MODEL=moondream
VISION_VLM_INTERVAL=75

VISION_YOLO_MODEL=yolov8n
VISION_YOLO_INTERVAL=3

# Toggles while bringing it up: start with VLM off, then YOLO, then everything.
VISION_NO_VLM=0
VISION_NO_YOLO=0
VISION_UI=0

# If vision has its own venv (e.g. with JetPack torch/OpenCV via --system-site-packages):
# VISION_PYTHON=/home/you/sage/.venv-vision/bin/python3
