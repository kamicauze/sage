# RTX 4070 Ti 12GB: voice node (STT + TTS on CUDA)
# Matches docs/CLUSTER_ARCHITECTURE.md ("The Senses"). Vision can run alongside via start_4070_core.sh.

# Point to the broker (Pi 5 controller, or the Mac Mini if it hosts Mosquitto).
MQTT_HOST=192.168.1.50
MQTT_PORT=1883

# STT: full-quality profile for 12GB VRAM (~3GB). Use small.en to free VRAM for Qwen TTS + vision.
STT_MODEL_SIZE=medium.en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_BEAM_SIZE=1
STT_SILENCE_DURATION=0.5
STT_MIN_SPEECH_MS=300
STT_VAD_THRESHOLD=0.5
# Fine-tuned Sheng Whisper (CTranslate2 dir), if exported:
# STT_MODEL_PATH=/home/you/sage/apps/brain-runtime/voice/models/whisper-sheng-ct2
# STT_LANGUAGE=sw

# TTS: kokoro first (fast, ~400ms). Switch to qwen once the loop is solid.
TTS_ENGINE=kokoro
TTS_PREWARM=true
TTS_IDLE_TIMEOUT=300
# TTS_ENGINE=qwen
# QWEN_TTS_MODEL=/home/you/sage/artifacts/voice/training/models/qwen3-tts-sheng-0.6b
# QWEN_TTS_SPEAKER=sage_sheng
# TTS_AUTO_FALLBACK=true

# Pin the speaker output if sound goes to the wrong sink (python -c "import sounddevice; print(sounddevice.query_devices())").
# TTS_OUTPUT_DEVICE=USB
# TTS_OUTPUT_DEVICE_INDEX=
