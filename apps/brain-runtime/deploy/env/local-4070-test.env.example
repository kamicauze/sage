# 4070 local lab profile: module-by-module validation before edge deployment.

# Use localhost broker for single-machine testing.
MQTT_HOST=localhost
MQTT_PORT=1883
SAGE_SKIP_BROKER=0

# Optional mosquitto config path for local broker startup.
# SAGE_MQTT_CONFIG=/home/you/sage/mosquitto.conf

# STT tuning for desktop validation.
STT_MODEL_SIZE=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_BEAM_SIZE=1

# TTS defaults.
TTS_ENGINE=kokoro
TTS_PREWARM=false
TTS_IDLE_TIMEOUT=90

# Vision defaults.
VISION_LOCATION=office
VISION_CAMERA=0
VISION_VLM_MODEL=moondream
VISION_VLM_INTERVAL=75
VISION_YOLO_MODEL=yolov8n
VISION_YOLO_INTERVAL=3
VISION_NO_VLM=0
VISION_NO_YOLO=0
VISION_UI=0

# If you maintain a dedicated vision venv, point to it.
# VISION_PYTHON=/home/you/sage/.venv-vision/bin/python3
