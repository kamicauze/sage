# Mac mini always-on control plane profile
# Runs: brain/router + API/UI + local LLM (MLX), while voice runs on 4070 worker.

# Broker/API bindings
MQTT_HOST=0.0.0.0
MQTT_PORT=1883

# Local LLM backend on Mac mini
SAGE_LOCAL_LLM_BACKEND=mlx
MLX_HOST=http://127.0.0.1:8080
MLX_HOST_FAST=http://127.0.0.1:8081
MLX_CHAT_ENDPOINT=/v1/chat/completions
MLX_HEALTH_ENDPOINT=/v1/models

# Pick model names available on your MLX server.
MLX_MODEL_FAST=mlx-community/Qwen2.5-3B-Instruct-4bit
MLX_MODEL_MID=mlx-community/Qwen2.5-7B-Instruct-4bit
MLX_MODEL_DEEP=mlx-community/Qwen2.5-7B-Instruct-4bit

# Keep voice pipelines remote (4070), but retain safe defaults if started accidentally.
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_ENGINE=kokoro
