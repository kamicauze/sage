# Jetson Orin Nano 8GB: FALLBACK voice node (STT + TTS). The Orin's main role is vision (orin-vision.env).

# The Mac Mini (hub) broker.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883

# STT memory/latency profile for 8GB Jetson.
STT_MODEL_SIZE=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_BEAM_SIZE=1
STT_SILENCE_DURATION=0.6

# Optional language hint (sw for Sheng/Swahili-heavy input).
# STT_LANGUAGE=sw

# TTS defaults for low VRAM pressure.
TTS_ENGINE=kokoro
TTS_PREWARM=false
TTS_IDLE_TIMEOUT=90

# Optional higher-quality TTS (enable only if you have headroom).
# TTS_ENGINE=qwen
# QWEN_TTS_MODEL=/home/ubuntu/sage/artifacts/voice/training/models/qwen3-tts-sheng-0.6b
# QWEN_TTS_SPEAKER=sage_sheng

# Optional CUDA allocator tuning.
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
