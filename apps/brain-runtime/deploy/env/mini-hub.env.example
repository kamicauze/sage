# Mac Mini M4 Pro: hub. Mosquitto broker for every node + voice switch controller.
# Later: the LLM brain (Gemma via MLX/Ollama) runs here too.

MQTT_PORT=1883

# Broker config: the repo's mosquitto.conf listens on the LAN (1883) and websockets (9001, for the PWA).
# Do not use brew's default config: Mosquitto 2 then only accepts connections from localhost.
# SAGE_MQTT_CONFIG=/Users/you/sage/mosquitto.conf

# Set to 1 if Mosquitto is managed some other way (and already listens on the LAN).
SAGE_SKIP_BROKER=0

# Voice -> Zigbee switch controller (registry: apps/brain-runtime/devices/switches.json).
SAGE_SWITCH_CONTROLLER=1
# SWITCH_WAKE_WORD=sage
